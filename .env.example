# Open ATS configuration.
# Copy to `.env` and adjust. Every variable is optional for a local try-out.

# --- Public URL ---------------------------------------------------------------
# The address people use to reach the app, without trailing slash. Used for links in
# emails, the sitemap, canonical URLs and authentication. Must match what the browser sees.
APP_URL=http://localhost:3000

# Host port published by docker-compose.override.yml (local use only).
APP_PORT=3000

# --- Database -----------------------------------------------------------------
# Used by the bundled Postgres service. Change the password before going to production.
POSTGRES_USER=openats
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openats
# Only needed when running the app outside Docker (npm run dev).
DATABASE_URL=postgres://openats:openats@localhost:5432/openats

# --- Security -----------------------------------------------------------------
# Secret used to sign sessions. Generate one with `openssl rand -base64 32`.
# When empty, the app generates one at first start and keeps it in the data volume.
AUTH_SECRET=

# Allow anyone to create an account and a new organisation (multi-organisation hosting).
# When false, only the very first account can be created freely; everyone else joins
# through an invitation.
ALLOW_SIGNUP=false

# --- Demo data ----------------------------------------------------------------
# Creates a fictional company with 6 jobs and 40 candidates at start-up, and shows the demo
# login on the sign-in page. The demo organisation never blocks the setup of your own.
# Keep false in production.
SEED_DEMO=false

# --- Email --------------------------------------------------------------------
# Without SMTP, emails are written to the server log and to the email journal
# (Paramètres > Emails) instead of being sent.
MAIL_FROM="Open ATS <no-reply@example.com>"
# Either a single URL...
SMTP_URL=
# ...or separate settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit TLS), false for STARTTLS on 587.
SMTP_SECURE=false

# --- Candidates' replies (optional) --------------------------------------------
# A shared mailbox read over IMAP. When set, emails to candidates go out with this mailbox
# as Reply-To, and replies appear in the candidate's « Échanges » tab. Use a dedicated
# address (for example recrutement@your-company.com); Open ATS does not modify the mailbox.
IMAP_HOST=
IMAP_PORT=993
# true for implicit TLS (port 993), false for a plain connection (port 143, tests only).
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# How often the mailbox is checked, in seconds.
IMAP_POLL_SECONDS=60
# Address candidates reply to. Defaults to IMAP_USER when it is an email address.
MAIL_REPLY_TO=

# --- Files --------------------------------------------------------------------
# local: files in DATA_DIR/uploads (the /data volume in Docker). s3: any S3-compatible storage.
STORAGE_DRIVER=local
# Outside Docker only. In Docker, DATA_DIR is /data.
DATA_DIR=./data
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted S3 servers.
S3_FORCE_PATH_STYLE=false

# --- Misc ---------------------------------------------------------------------
# Time zone used to display dates in emails and on the server.
APP_TIMEZONE=Europe/Paris
# Anonymise candidates past the retention period every 6 hours (true by default).
RETENTION_JOB=true
